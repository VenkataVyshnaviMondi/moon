    {
      "name": "Project Enquiry Field",
      "kind": "input",
      "refersTo": "field-input",
      "description": "A persistent label and white text field from the light contact form.",
      "html": "<div class=\"ds-field\"><label for=\"ds-fullname\">Full name <span aria-hidden=\"true\">*</span></label><input id=\"ds-fullname\" name=\"fullName\" autocomplete=\"name\" placeholder=\"Your name\" required minlength=\"2\" maxlength=\"100\"/></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;max-width:340px;color:var(--navy,#101725);font-family:Sora,Arial,sans-serif}.ds-field label{font-size:12px;font-weight:500;line-height:1.5}.ds-field input{min-width:0;min-height:46px;background:#fff;border:1px solid #d6dccb;border-radius:5px;color:var(--navy,#101725);padding:12px;font:400 13px/1.6 Sora,Arial,sans-serif;caret-color:#365418}.ds-field input::placeholder{color:#687162;opacity:1}.ds-field input:focus-visible{outline:2px solid #446515;outline-offset:2px;border-color:#446515}"
    },
    {
      "name": "Section Navigation",
      "kind": "nav",
      "description": "The desktop section-link language on solid navy; the application adds a labelled mobile toggle.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Main navigation\"><a href=\"#services\">Services</a><a href=\"#about\">About</a><a href=\"#work\">Work</a><a href=\"#contact\">Contact</a></nav>",
      "css": ".ds-navigation{display:flex;flex-wrap:wrap;align-items:center;gap:30px;background:var(--navy,#101725);padding:16px 24px;font-family:Sora,Arial,sans-serif}.ds-navigation a{display:flex;align-items:center;min-height:44px;color:#d7dce4;font-size:13px;text-decoration:none;transition:color .18s}.ds-navigation a:hover{color:var(--lime,#d5f77c)}.ds-navigation a:focus-visible{outline:3px solid var(--cyan,#8ce0e6);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-navigation a{transition:none}}"
    },
    {
      "name": "Service Group and Linked Row",
      "kind": "card",
      "refersTo": "service-group",
      "description": "A coral marketing row inside the navy service shell, with its title, description and enquiry arrow.",
      "html": "<div class=\"ds-service-group\"><h3>Digital Marketing</h3><p class=\"ds-service-subtitle\">Get seen. Get remembered.</p><a class=\"ds-service-row\" href=\"#contact\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 3 6 6 3-6 3-3 6-3-6-6-3 6-3Z\"/></svg><div><h4>Branding</h4><p>A clear identity and a consistent voice that make your business unmistakably yours.</p></div><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a></div>",
      "css": ".ds-service-group{max-width:520px;background:#1b2534;border:1px solid #303b48;border-radius:13px;overflow:hidden;padding:28px 30px 12px;color:var(--text,#f6f7f2);font-family:Sora,Arial,sans-serif}.ds-service-group h3{margin:0;font-size:25px;font-weight:500;line-height:1.25;letter-spacing:-.025em}.ds-service-subtitle{margin:10px 0 24px;color:var(--muted,#adb5c2);font-size:12px;line-height:1.75}.ds-service-row{display:flex;align-items:flex-start;gap:17px;padding:23px 0;border-top:1px solid #3b4754;color:inherit;text-decoration:none}.ds-service-row>svg:first-child{color:var(--coral,#f0a5a6);flex-shrink:0;margin-top:2px}.ds-service-row>div{flex:1}.ds-service-row h4{margin:0;font-size:16px;font-weight:500;line-height:1.5;letter-spacing:-.025em}.ds-service-row p{margin:6px 0 0;font-size:13px;line-height:1.8;color:#b0b9c5;max-width:330px}.ds-service-row>svg:last-child{width:16px;height:16px;flex-shrink:0;color:#9eaaba;margin-top:4px;transition:transform .18s,color .18s}.ds-service-row:hover h4,.ds-service-row:hover>svg:last-child{color:var(--lime,#d5f77c)}.ds-service-row:hover>svg:last-child{transform:translate(3px,-3px)}.ds-service-row:focus-visible{outline:3px solid var(--cyan,#8ce0e6);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-service-row>svg:last-child{transition:none}}"
    },
    {
      "name": "Text Link",
      "kind": "custom",
      "description": "A quiet inline action with a diagonal arrow, used between sections.",
      "html": "<a class=\"ds-text-link\" href=\"#contact\">Talk about your project <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-text-link{display:inline-flex;gap:22px;align-items:center;color:var(--text,#f6f7f2);font:500 13px/1.75 Sora,Arial,sans-serif;text-decoration:none}.ds-text-link svg{transition:transform .18s}.ds-text-link:hover svg{transform:translate(3px,-3px)}.ds-text-link:focus-visible{outline:3px solid var(--cyan,#8ce0e6);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-text-link svg{transition:none}}"
