      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lime primary action on a dark surface, with a restrained arrow state.",
      "html": "<a class=\"ds-button-primary\" href=\"#services\">Explore Our Services <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:54px;padding:16px 23px;border:0;border-radius:7px;font:600 13px/1.4 Sora,Arial,sans-serif;text-decoration:none;cursor:pointer;transition:background .18s,transform .18s;background:var(--lime,#d5f77c);color:var(--navy,#101725)}.ds-button-primary svg{transition:transform .18s}.ds-button-primary:hover{background:#e2ffa0}.ds-button-primary:hover svg{transform:translate(2px,-2px)}.ds-button-primary:focus-visible{outline:3px solid var(--cyan,#8ce0e6);outline-offset:5px}.ds-button-primary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button-primary,.ds-button-primary svg{transition:none}}"
    },
    {
      "name": "Contact Button",
      "kind": "button",
      "refersTo": "button-contact",
      "description": "Navy action used on the paper contact form; default deployment prepares an email draft.",
      "html": "<button class=\"ds-button-contact\" type=\"button\">Prepare enquiry email <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-button-contact{display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:54px;padding:16px 23px;border:0;border-radius:7px;font:600 13px/1.4 Sora,Arial,sans-serif;text-decoration:none;cursor:pointer;transition:background .18s,transform .18s;background:var(--navy,#101725);color:var(--paper,#f5f5ef)}.ds-button-contact svg{transition:transform .18s}.ds-button-contact:hover{background:#28364a}.ds-button-contact:hover svg{transform:translate(2px,-2px)}.ds-button-contact:focus-visible{outline:3px solid #446515;outline-offset:5px}.ds-button-contact:active{transform:translateY(1px)}.ds-button-contact:disabled{opacity:.65;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-button-contact,.ds-button-contact svg{transition:none}}"
