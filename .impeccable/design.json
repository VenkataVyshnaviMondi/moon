  "narrative": {
    "northStar": "Good Ideas, Connected",
    "overview": "Mooncrafters brings creative thinking and practical technology into one confident, approachable world. Deep navy gives bright lime, cyan and coral room to speak; oversized Sora headings, clear service groups and generous spacing carry the message.\n\nStatic geometric diagrams supply the expressive character. Fine orbital lines, a restrained sphere gradient and small tilted labels create depth while the reading path stays direct. Content is visible immediately; interaction uses short CSS state transitions and respects reduced motion.",
    "keyCharacteristics": [
      "Deep navy foundation with lime actions and cyan/coral accents.",
      "One locally hosted Sora variable font for display, body and controls.",
      "Generous responsive spacing, fine rules and modest corner radii.",
      "Static, authored SVG geometry with restrained gradient depth.",
      "Visible content, explicit labels and clear keyboard focus."
    ],
    "rules": [
      {
        "name": "The Visible Content Rule",
        "body": "The initial page content stays visible. Do not introduce entrance gates, opacity-zero reveals or animation dependencies.",
        "section": "elevation"
      },
      {
        "name": "The Action Accent Rule",
        "body": "Lime marks primary actions and key emphasis. Cyan and coral distinguish supporting ideas; color never replaces the label.",
        "section": "colors"
      },
      {
        "name": "The One Font Rule",
        "body": "Use the local Sora family throughout. Build hierarchy with size, weight, tracking and space rather than additional display faces.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Keep ordinary content flat. Reserve diffuse shadows and gradients for the orbital illustration, its labels and the contact form.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the navy foundation, lime primary actions and visible focus treatment.",
      "Do keep service names and descriptions readable, with consistent grouped rows.",
      "Do use static SVG geometry and modest gradients for expressive illustration.",
      "Do preserve the responsive single-column reading order and generous section spacing.",
      "Do keep content visible before JavaScript hydration and respect reduced motion."
    ],
    "donts": [
      "Don't add autoplay video, particles, WebGL or continuous animation to the loading path.",
      "Don't hide page content behind entrance animations.",
      "Don't replace the local Sora family with multiple remote font families.",
      "Don't use invented client results, testimonials or performance counters as visual proof.",
      "Don't give every content block a glow, gradient or oversized rounded shell."
    ]
  }
}
